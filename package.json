{
  "name": "personal-ai-sovereignty-lab",
  "version": "1.0.0-rc.0",
  "private": true,
  "type": "module",
  "description": "A local-first simulation and evaluation harness for user-sovereign personal AI agents.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/evals/cli.ts",
    "model:eval": "tsx src/evals/modelCli.ts",
    "adversarial:model": "tsx src/evals/adversarialModelCli.ts",
    "harness:eval": "tsx src/evals/harnessCli.ts",
    "harness:model": "tsx src/evals/harnessModelCli.ts",
    "harness:model:write": "tsx src/evals/harnessModelCli.ts --write",
    "demo:leak": "tsx src/evals/demoLeakCli.ts",
    "frontier:eval": "tsx src/evals/sovereigntyFrontierCli.ts",
    "paper:tables": "tsx src/evals/paperTablesCli.ts",
    "annotation:sample": "tsx src/evals/annotationSampleCli.ts",
    "annotation:agreement": "tsx src/evals/annotationAgreementV2Cli.ts",
    "difficulty:calibrate": "tsx src/evals/difficultyCalibrationCli.ts",
    "difficulty:calibrate:write": "tsx src/evals/difficultyCalibrationCli.ts --write",
    "scenarios:generate": "tsx src/generator/cli.ts",
    "confinement:probe": "tsx src/evals/osConfinementCli.ts",
    "confinement:write": "tsx src/evals/osConfinementCli.ts --write",
    "confinement:container": "tsx src/evals/containerConfinementCli.ts",
    "confinement:container:write": "tsx src/evals/containerConfinementCli.ts --write",
    "submitted:runner": "tsx src/evals/submittedArtifactRunnerCli.ts",
    "submitted:runner:write": "tsx src/evals/submittedArtifactRunnerCli.ts --write",
    "artifact:bundles": "tsx src/evals/artifactBundleCli.ts",
    "artifact:bundles:write": "tsx src/evals/artifactBundleCli.ts --write",
    "runner:hardening": "tsx src/evals/runnerHardeningCli.ts",
    "runner:hardening:write": "tsx src/evals/runnerHardeningCli.ts --write",
    "artifact:manifest": "tsx src/evals/artifactManifestCli.ts write",
    "artifact:verify": "tsx src/evals/artifactManifestCli.ts verify",
    "verify": "pnpm eval && pnpm artifact:manifest && pnpm artifact:verify && pnpm test && pnpm build",
    "artifact:check": "pnpm eval && pnpm artifact:manifest && pnpm artifact:verify"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "lucide-react": "0.561.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.22.3",
    "vitest": "4.1.9"
  }
}
