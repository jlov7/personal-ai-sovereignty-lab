{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.local/schemas/tool-trace-report.schema.json",
  "title": "Personal AI Sovereignty Tool Trace Report",
  "type": "object",
  "required": [
    "benchmark",
    "version",
    "generatedAt",
    "scenarioCount",
    "toolCallCount",
    "executedCount",
    "blockedCount",
    "unsafeRawAttemptsBlocked",
    "policyViolationCount",
    "traces",
    "limitations"
  ],
  "properties": {
    "benchmark": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scenarioCount": { "type": "integer", "minimum": 1 },
    "toolCallCount": { "type": "integer", "minimum": 1 },
    "executedCount": { "type": "integer", "minimum": 0 },
    "blockedCount": { "type": "integer", "minimum": 0 },
    "unsafeRawAttemptsBlocked": { "type": "integer", "minimum": 0 },
    "policyViolationCount": { "type": "integer", "minimum": 0 },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scenarioId",
          "toolCallCount",
          "executedCount",
          "blockedCount",
          "policyViolationCount",
          "calls",
          "interpretation"
        ],
        "properties": {
          "scenarioId": { "type": "string" },
          "toolCallCount": { "type": "integer", "minimum": 1 },
          "executedCount": { "type": "integer", "minimum": 0 },
          "blockedCount": { "type": "integer", "minimum": 0 },
          "policyViolationCount": { "type": "integer", "minimum": 0 },
          "interpretation": { "type": "string" },
          "calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "scenarioId",
                "toolName",
                "targetLayer",
                "dataItemIds",
                "releaseForm",
                "purpose",
                "status",
                "expected",
                "policyCompliant",
                "responseSummary",
                "policyEvidence"
              ],
              "properties": {
                "id": { "type": "string" },
                "scenarioId": { "type": "string" },
                "toolName": { "type": "string" },
                "targetLayer": { "enum": ["local", "personal_cloud", "federated"] },
                "dataItemIds": { "type": "array", "items": { "type": "string" } },
                "releaseForm": {
                  "enum": ["none", "local_reference", "aggregate", "minimized_payload", "raw_payload"]
                },
                "purpose": { "type": "string" },
                "status": { "enum": ["executed", "blocked", "local_only"] },
                "expected": { "enum": ["must_execute", "must_block"] },
                "policyCompliant": { "type": "boolean" },
                "egressDecision": { "type": "object" },
                "consentReceiptId": { "type": "string" },
                "responseSummary": { "type": "string" },
                "policyEvidence": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
