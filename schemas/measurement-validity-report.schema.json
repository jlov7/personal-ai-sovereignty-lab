{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.local/schemas/measurement-validity-report.schema.json",
  "title": "Personal AI Sovereignty Measurement Validity Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "version",
    "generatedAt",
    "status",
    "labelCalibrationPacket",
    "disagreementTemplates",
    "syntheticAgreementChecks",
    "metricAblations",
    "scenarioDifficulty",
    "blockers",
    "limitations"
  ],
  "properties": {
    "benchmark": { "type": "string", "const": "personal-ai-sovereignty-benchmark" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "const": "local_calibration_scaffold" },
    "labelCalibrationPacket": { "$ref": "#/$defs/labelCalibrationPacket" },
    "disagreementTemplates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/disagreementTemplate" }
    },
    "syntheticAgreementChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "annotationCount",
          "pairwiseExactAgreement",
          "meanAbsoluteDistance",
          "expected",
          "passed",
          "countsAsValidation"
        ],
        "properties": {
          "id": { "type": "string" },
          "purpose": { "type": "string" },
          "annotationCount": { "type": "integer", "minimum": 0 },
          "pairwiseExactAgreement": { "type": "number", "minimum": 0, "maximum": 1 },
          "meanAbsoluteDistance": { "type": "number", "minimum": 0 },
          "expected": { "type": "string" },
          "passed": { "type": "boolean" },
          "countsAsValidation": { "type": "boolean", "const": false }
        }
      }
    },
    "metricAblations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles", "results", "largestScenarioShifts"],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rationale", "weights"],
            "properties": {
              "id": { "type": "string" },
              "rationale": { "type": "string" },
              "weights": { "$ref": "#/$defs/metricWeights" }
            }
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profileId",
              "averageScore",
              "weakestScenarioId",
              "strongestScenarioId",
              "averageDeltaFromEqual"
            ],
            "properties": {
              "profileId": { "type": "string" },
              "averageScore": { "type": "number", "minimum": 0, "maximum": 100 },
              "weakestScenarioId": { "type": "string" },
              "strongestScenarioId": { "type": "string" },
              "averageDeltaFromEqual": { "type": "number" }
            }
          }
        },
        "largestScenarioShifts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenarioId", "profileId", "equalScore", "profileScore", "delta"],
            "properties": {
              "scenarioId": { "type": "string" },
              "profileId": { "type": "string" },
              "equalScore": { "type": "number", "minimum": 0, "maximum": 100 },
              "profileScore": { "type": "number", "minimum": 0, "maximum": 100 },
              "delta": { "type": "number" }
            }
          }
        }
      }
    },
    "scenarioDifficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tags", "difficultyCoverage", "ambiguityCoverage"],
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenarioId", "difficulty", "ambiguity", "reasons"],
            "properties": {
              "scenarioId": { "type": "string" },
              "difficulty": { "type": "string", "enum": ["low", "medium", "high"] },
              "ambiguity": { "type": "string", "enum": ["low", "medium", "high"] },
              "reasons": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "difficultyCoverage": { "$ref": "#/$defs/coverageBuckets" },
        "ambiguityCoverage": { "$ref": "#/$defs/coverageBuckets" }
      }
    },
    "blockers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "$defs": {
    "labelCalibrationPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "instructions"],
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metricId",
              "construct",
              "observableEvidence",
              "reviewerQuestion",
              "failureSignals",
              "scoreAnchors"
            ],
            "properties": {
              "metricId": { "$ref": "#/$defs/metricId" },
              "construct": { "type": "string" },
              "observableEvidence": { "type": "array", "items": { "type": "string" } },
              "reviewerQuestion": { "type": "string" },
              "failureSignals": { "type": "array", "items": { "type": "string" } },
              "scoreAnchors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["range", "evidenceStandard"],
                  "properties": {
                    "range": { "type": "string" },
                    "evidenceStandard": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "instructions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "disagreementTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "requiredEvidence", "adjudicationRule"],
      "properties": {
        "id": { "type": "string" },
        "trigger": { "type": "string" },
        "requiredEvidence": { "type": "array", "items": { "type": "string" } },
        "adjudicationRule": { "type": "string" }
      }
    },
    "coverageBuckets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "count", "percentage"],
        "properties": {
          "id": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 },
          "percentage": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "metricId": {
      "type": "string",
      "enum": [
        "usefulness",
        "privacy_preservation",
        "autonomy_appropriateness",
        "explainability",
        "latency",
        "data_minimization",
        "user_control_alignment",
        "consented_escalation"
      ]
    },
    "metricWeights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usefulness",
        "privacy_preservation",
        "autonomy_appropriateness",
        "explainability",
        "latency",
        "data_minimization",
        "user_control_alignment",
        "consented_escalation"
      ],
      "properties": {
        "usefulness": { "type": "number", "minimum": 0 },
        "privacy_preservation": { "type": "number", "minimum": 0 },
        "autonomy_appropriateness": { "type": "number", "minimum": 0 },
        "explainability": { "type": "number", "minimum": 0 },
        "latency": { "type": "number", "minimum": 0 },
        "data_minimization": { "type": "number", "minimum": 0 },
        "user_control_alignment": { "type": "number", "minimum": 0 },
        "consented_escalation": { "type": "number", "minimum": 0 }
      }
    }
  }
}
