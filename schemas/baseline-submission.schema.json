{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.local/schemas/baseline-submission.schema.json",
  "title": "Personal AI Sovereignty Baseline Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submissionId",
    "submittedAt",
    "systemName",
    "systemVersion",
    "systemType",
    "submitter",
    "runtime",
    "claimBoundaries",
    "scenarioResults",
    "artifacts"
  ],
  "properties": {
    "submissionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "submittedAt": { "type": "string", "format": "date-time" },
    "systemName": { "type": "string", "minLength": 2 },
    "systemVersion": { "type": "string", "minLength": 1 },
    "systemType": {
      "type": "string",
      "enum": [
        "deterministic_reference",
        "local_model",
        "cloud_model",
        "tool_using_agent",
        "production_personal_agent",
        "negative_control"
      ]
    },
    "submitter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "independence"],
      "properties": {
        "name": { "type": "string" },
        "independence": {
          "type": "string",
          "enum": ["author_seed", "independent_external", "vendor_self_report"]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "tools", "environment", "networkPolicy"],
      "properties": {
        "model": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "string" },
        "networkPolicy": { "type": "string" }
      }
    },
    "claimBoundaries": { "type": "array", "items": { "type": "string" } },
    "scenarioResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenarioId",
          "totalScore",
          "privacyBoundaryViolations",
          "consentViolations",
          "toolCalls",
          "notes"
        ],
        "properties": {
          "scenarioId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "totalScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "privacyBoundaryViolations": { "type": "integer", "minimum": 0 },
          "consentViolations": { "type": "integer", "minimum": 0 },
          "toolCalls": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runLog", "transcript", "toolTrace"],
      "properties": {
        "runLog": { "type": ["string", "null"] },
        "transcript": { "type": ["string", "null"] },
        "toolTrace": { "type": ["string", "null"] }
      }
    }
  }
}
