{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.dev/schemas/statistical-report.schema.json",
  "title": "Personal AI Sovereignty Benchmark Statistical Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "version",
    "generatedAt",
    "scenarioCount",
    "scoreDistribution",
    "bootstrapMeanInterval",
    "metricDistributions",
    "weakestScenarios",
    "detectableEffectEstimates",
    "sensitivityRows",
    "maxSensitivitySwing",
    "interpretation",
    "limitations"
  ],
  "properties": {
    "benchmark": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scenarioCount": { "type": "integer", "minimum": 1 },
    "scoreDistribution": { "$ref": "#/$defs/distribution" },
    "bootstrapMeanInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "resamples", "lower", "mean", "upper"],
      "properties": {
        "confidence": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "resamples": { "type": "integer", "minimum": 1 },
        "lower": { "type": "number", "minimum": 0, "maximum": 100 },
        "mean": { "type": "number", "minimum": 0, "maximum": 100 },
        "upper": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "metricDistributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metricId", "label", "mean", "min", "p10", "median", "p90", "max"],
        "properties": {
          "metricId": {
            "type": "string",
            "enum": [
              "usefulness",
              "privacy_preservation",
              "autonomy_appropriateness",
              "explainability",
              "latency",
              "data_minimization",
              "user_control_alignment",
              "consented_escalation"
            ]
          },
          "label": { "type": "string" },
          "mean": { "type": "number", "minimum": 0, "maximum": 100 },
          "min": { "type": "number", "minimum": 0, "maximum": 100 },
          "p10": { "type": "number", "minimum": 0, "maximum": 100 },
          "median": { "type": "number", "minimum": 0, "maximum": 100 },
          "p90": { "type": "number", "minimum": 0, "maximum": 100 },
          "max": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "weakestScenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenarioId", "totalScore", "grade"],
        "properties": {
          "scenarioId": { "type": "string" },
          "totalScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "grade": { "type": "string", "enum": ["excellent", "strong", "mixed", "weak"] }
        }
      }
    },
    "detectableEffectEstimates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetMeanDifference",
          "assumedStdDev",
          "alpha",
          "power",
          "pairedScenarioCountNeeded",
          "currentScenarioCountSufficient",
          "interpretation"
        ],
        "properties": {
          "targetMeanDifference": { "type": "number", "exclusiveMinimum": 0 },
          "assumedStdDev": { "type": "number", "minimum": 0 },
          "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
          "power": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
          "pairedScenarioCountNeeded": { "type": "integer", "minimum": 1 },
          "currentScenarioCountSufficient": { "type": "boolean" },
          "interpretation": { "type": "string" }
        }
      }
    },
    "sensitivityRows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "weightOverrides",
          "averageScore",
          "deltaFromBase",
          "weakestScenarioId",
          "weakestScenarioScore"
        ],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "weightOverrides": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0 }
          },
          "averageScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "deltaFromBase": { "type": "number" },
          "weakestScenarioId": { "type": "string" },
          "weakestScenarioScore": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "maxSensitivitySwing": { "type": "number", "minimum": 0 },
    "interpretation": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "min", "p10", "median", "p90", "max"],
      "properties": {
        "mean": { "type": "number", "minimum": 0, "maximum": 100 },
        "min": { "type": "number", "minimum": 0, "maximum": 100 },
        "p10": { "type": "number", "minimum": 0, "maximum": 100 },
        "median": { "type": "number", "minimum": 0, "maximum": 100 },
        "p90": { "type": "number", "minimum": 0, "maximum": 100 },
        "max": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
