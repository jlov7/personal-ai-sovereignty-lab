{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.local/schemas/artifact-bundle-verification-report.schema.json",
  "title": "Personal AI Sovereignty Artifact Bundle Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "version",
    "generatedAt",
    "status",
    "sourcePaths",
    "bundleCount",
    "passedBundleCount",
    "rejectedBundleCount",
    "expectedFailureCount",
    "expectationMatchCount",
    "bundles",
    "limitations"
  ],
  "properties": {
    "benchmark": { "type": "string", "const": "personal-ai-sovereignty-benchmark" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["passed", "failed"] },
    "sourcePaths": { "type": "array", "items": { "type": "string" } },
    "bundleCount": { "type": "integer", "minimum": 1 },
    "passedBundleCount": { "type": "integer", "minimum": 0 },
    "rejectedBundleCount": { "type": "integer", "minimum": 0 },
    "expectedFailureCount": { "type": "integer", "minimum": 0 },
    "expectationMatchCount": { "type": "integer", "minimum": 0 },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "bundleDir",
          "manifestPath",
          "manifestSha256",
          "verificationStatus",
          "expectedStatus",
          "expectationMatched",
          "checks",
          "sourcePaths",
          "limitations"
        ],
        "properties": {
          "artifactId": { "type": "string" },
          "bundleDir": { "type": "string" },
          "manifestPath": { "type": "string" },
          "manifestSha256": { "type": ["string", "null"] },
          "verificationStatus": { "type": "string", "enum": ["pass", "fail"] },
          "expectedStatus": { "type": ["string", "null"], "enum": ["pass", "fail", null] },
          "expectationMatched": { "type": ["boolean", "null"] },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "passed", "evidence"],
              "properties": {
                "id": { "type": "string" },
                "passed": { "type": "boolean" },
                "evidence": { "type": "string" }
              }
            }
          },
          "sourcePaths": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
