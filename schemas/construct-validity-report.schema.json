{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.dev/schemas/construct-validity-report.schema.json",
  "title": "Personal AI Sovereignty Construct Validity Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark", "version", "generatedAt", "checks", "blockers", "frontierInterpretation"],
  "properties": {
    "benchmark": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence", "interpretation"],
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "partial", "blocked_external"] },
          "evidence": { "type": "string" },
          "interpretation": { "type": "string" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "frontierInterpretation": { "type": "string" }
  }
}
