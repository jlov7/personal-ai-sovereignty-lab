{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.dev/schemas/enforcement-report.schema.json",
  "title": "Personal AI Sovereignty Egress Enforcement Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "version",
    "generatedAt",
    "scenarioCount",
    "probeCount",
    "passed",
    "failed",
    "passRate",
    "probes",
    "limitations"
  ],
  "properties": {
    "benchmark": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scenarioCount": { "type": "integer", "minimum": 1 },
    "probeCount": { "type": "integer", "minimum": 1 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "passRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scenarioId",
          "dataItemId",
          "expectedAllowed",
          "observedAllowed",
          "passed",
          "reason",
          "controls"
        ],
        "properties": {
          "id": { "type": "string" },
          "scenarioId": { "type": "string" },
          "dataItemId": { "type": "string" },
          "expectedAllowed": { "type": "boolean" },
          "observedAllowed": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "reason": { "type": "string" },
          "controls": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
