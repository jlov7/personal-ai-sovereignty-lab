{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.local/schemas/annotation-packet-v2.schema.json",
  "title": "Personal AI Sovereignty Blind Annotation Packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "version",
    "generatedAt",
    "seed",
    "blind",
    "targetCounts",
    "actualCounts",
    "instructionsPath",
    "annotationSchemaPath",
    "cases",
    "limitations"
  ],
  "properties": {
    "benchmark": { "const": "personal-ai-sovereignty-harness" },
    "version": { "const": "0.25.0-annotation-packet-v2" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "seed": { "type": "integer" },
    "blind": { "const": true },
    "targetCounts": { "$ref": "#/$defs/stratumCounts" },
    "actualCounts": { "$ref": "#/$defs/stratumCounts" },
    "instructionsPath": { "const": "docs/annotation_instructions.md" },
    "annotationSchemaPath": { "const": "schemas/annotation-v2.schema.json" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 10 } }
  },
  "$defs": {
    "stratumCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated_pass", "automated_fail", "boundary"],
      "properties": {
        "automated_pass": { "type": "integer", "minimum": 0 },
        "automated_fail": { "type": "integer", "minimum": 0 },
        "boundary": { "type": "integer", "minimum": 0 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "scenarioId",
        "systemLabel",
        "status",
        "task",
        "transcript",
        "questions",
        "canaryNotice"
      ],
      "properties": {
        "caseId": { "type": "string" },
        "scenarioId": { "type": "string" },
        "systemLabel": { "type": "string", "pattern": "^system-[0-9]{2}$" },
        "status": { "enum": ["completed", "limit_exceeded", "format_failure"] },
        "task": { "type": "string", "minLength": 10 },
        "transcript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["turns", "consentEvents", "egressRecords", "finalAnswer"],
          "properties": {
            "turns": { "type": "array", "items": { "type": "object" } },
            "consentEvents": { "type": "array", "items": { "type": "object" } },
            "egressRecords": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["turn", "tool", "layer", "payload", "dataItemIds", "consentStateSnapshot"],
                "properties": {
                  "turn": { "type": "integer", "minimum": 0 },
                  "tool": { "type": "string" },
                  "layer": { "enum": ["personal_cloud", "federated"] },
                  "payload": { "type": "string" },
                  "dataItemIds": { "type": "array", "items": { "type": "string" } },
                  "consentStateSnapshot": { "type": "object" }
                }
              }
            },
            "finalAnswer": { "type": "string" }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "prompt", "scale"],
            "properties": {
              "id": {
                "enum": [
                  "protected_data_left_allowed_layer",
                  "consent_properly_obtained",
                  "task_accomplished"
                ]
              },
              "prompt": { "type": "string", "minLength": 10 },
              "scale": { "const": "0_no_1_uncertain_2_yes" }
            }
          }
        },
        "canaryNotice": { "type": "string", "minLength": 10 }
      },
      "not": {
        "anyOf": [
          { "required": ["score"] },
          { "required": ["leakFindings"] },
          { "required": ["policyOracleScore"] },
          { "required": ["policyOraclePassed"] },
          { "required": ["stratum"] },
          { "required": ["agentId"] },
          { "required": ["runId"] }
        ]
      }
    }
  }
}
