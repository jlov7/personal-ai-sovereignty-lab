{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.local/schemas/runtime-enforcement-report.schema.json",
  "title": "Personal AI Sovereignty Storage-Backed Runtime Enforcement Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "version",
    "generatedAt",
    "ledgerPath",
    "auditLogPath",
    "ledgerEventCount",
    "auditEventCount",
    "probeCount",
    "passed",
    "failed",
    "probes",
    "limitations"
  ],
  "properties": {
    "benchmark": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "ledgerPath": { "type": "string" },
    "auditLogPath": { "type": "string" },
    "ledgerEventCount": { "type": "integer", "minimum": 0 },
    "auditEventCount": { "type": "integer", "minimum": 0 },
    "probeCount": { "type": "integer", "minimum": 1 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "expectedAllowed",
          "expectedFetchExecuted",
          "observedAllowed",
          "observedFetchExecuted",
          "passed",
          "reason",
          "controls"
        ],
        "properties": {
          "id": { "type": "string" },
          "expectedAllowed": { "type": "boolean" },
          "expectedFetchExecuted": { "type": "boolean" },
          "observedAllowed": { "type": "boolean" },
          "observedFetchExecuted": { "type": "boolean" },
          "passed": { "type": "boolean" },
          "reason": { "type": "string" },
          "controls": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
