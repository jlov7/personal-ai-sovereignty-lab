{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.local/schemas/external-agent-trace.schema.json",
  "title": "Personal AI Sovereignty External Agent Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "traceId",
    "submittedAt",
    "systemName",
    "systemVersion",
    "systemType",
    "scenarioId",
    "consentState",
    "actions",
    "finalAnswerSummary",
    "claimBoundaries"
  ],
  "properties": {
    "traceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "submittedAt": { "type": "string", "format": "date-time" },
    "systemName": { "type": "string", "minLength": 2 },
    "systemVersion": { "type": "string", "minLength": 1 },
    "systemType": {
      "type": "string",
      "enum": [
        "deterministic_reference",
        "local_model",
        "cloud_model",
        "tool_using_agent",
        "production_personal_agent",
        "negative_control"
      ]
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "consentState": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actionId",
          "label",
          "toolName",
          "layer",
          "dataItemIds",
          "releaseForm",
          "status",
          "consentReceiptId",
          "rationale"
        ],
        "properties": {
          "actionId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": { "type": "string" },
          "toolName": { "type": ["string", "null"] },
          "layer": { "type": "string", "enum": ["local", "personal_cloud", "federated"] },
          "dataItemIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "releaseForm": {
            "type": "string",
            "enum": ["none", "local_reference", "minimized_payload", "aggregate", "raw_payload"]
          },
          "status": {
            "type": "string",
            "enum": ["completed", "blocked", "needs_user_approval"]
          },
          "consentReceiptId": { "type": ["string", "null"] },
          "rationale": { "type": "string" }
        }
      }
    },
    "finalAnswerSummary": { "type": "string" },
    "claimBoundaries": { "type": "array", "items": { "type": "string" } }
  }
}
