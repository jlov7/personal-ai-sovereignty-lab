{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.dev/schemas/benchmark-card.schema.json",
  "title": "Personal AI Sovereignty Benchmark Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "intendedUse",
    "notIntendedFor",
    "scenarioCoverage",
    "metrics",
    "adversarialChecks",
    "knownLimitations",
    "researchQuestions"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
    },
    "intendedUse": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "notIntendedFor": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "scenarioCoverage": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "adversarialChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "knownLimitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "researchQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "humanAnnotation": {
      "type": "string",
      "minLength": 10
    }
  }
}
