{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.dev/schemas/release-checklist.schema.json",
  "title": "Personal AI Sovereignty Release Checklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark", "version", "generatedAt", "items"],
  "properties": {
    "benchmark": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence", "note"],
      "properties": {
        "id": { "type": "string" },
        "status": {
          "enum": ["ready", "partial", "blocked_external", "not_applicable"]
        },
        "evidence": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
