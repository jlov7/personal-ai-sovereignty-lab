{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.dev/schemas/artifact-manifest.schema.json",
  "title": "Personal AI Sovereignty Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark", "version", "generatedAt", "artifactCount", "entries", "verificationCommand"],
  "properties": {
    "benchmark": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "artifactCount": { "type": "integer", "minimum": 1 },
    "verificationCommand": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
