{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-sovereignty-lab.dev/schemas/annotation-packet.schema.json",
  "title": "Personal AI Sovereignty External Annotation Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark", "version", "generatedAt", "instructions", "annotationSchemaPath", "cases"],
  "properties": {
    "benchmark": { "type": "string" },
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "annotationSchemaPath": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/annotationCase" }
    }
  },
  "$defs": {
    "annotationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "scenarioId",
        "modelName",
        "priority",
        "policyOraclePassed",
        "policyOracleScore",
        "reviewFocus",
        "failedFindings",
        "transcriptExcerpt",
        "requiredReviewerRoles"
      ],
      "properties": {
        "caseId": { "type": "string" },
        "scenarioId": { "type": "string" },
        "modelName": { "type": "string" },
        "priority": { "enum": ["calibration", "high", "standard"] },
        "policyOraclePassed": { "type": "boolean" },
        "policyOracleScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reviewFocus": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "failedFindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "transcriptExcerpt": { "type": "string" },
        "requiredReviewerRoles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "passed", "evidence", "expectation"],
      "properties": {
        "id": { "type": "string" },
        "severity": { "type": "string" },
        "passed": { "type": "boolean" },
        "evidence": { "type": "string" },
        "expectation": { "type": "string" }
      }
    }
  }
}
